####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/home/valino/usr/lib || mkdir -p $(INSTALL_ROOT)/home/valino/usr/lib
	$(QINSTALL_PROGRAM) lib/$(TARGET) $(INSTALL_ROOT)/home/valino/usr/lib/$(TARGET)
	-$(STRIP) --strip-unneeded $(INSTALL_ROOT)/home/valino/usr/lib/$(TARGET)
	-$(SYMLINK) $(TARGET) $(INSTALL_ROOT)/home/valino/usr/lib/$(TARGET0)
	-$(SYMLINK) $(TARGET) $(INSTALL_ROOT)/home/valino/usr/lib/$(TARGET1)
	-$(SYMLINK) $(TARGET) $(INSTALL_ROOT)/home/valino/usr/lib/$(TARGET2)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/home/valino/usr/lib/$(TARGET) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/home/valino/usr/lib/$(TARGET0) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/home/valino/usr/lib/$(TARGET1) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/home/valino/usr/lib/$(TARGET2)
	-$(DEL_DIR) $(INSTALL_ROOT)/home/valino/usr/lib/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

.SUFFIXES:


####### Install

install_target: first FORCE
	@$(CHK_DIR_EXISTS) $(INSTALL_ROOT)/home/picazo/usr/lib/ || $(MKDIR) $(INSTALL_ROOT)/home/picazo/usr/lib/ 
	-$(INSTALL_PROGRAM) "lib/$(TARGET)" "$(INSTALL_ROOT)/home/picazo/usr/lib/$(TARGET)"
	-$(SYMLINK) "$(TARGET)" "$(INSTALL_ROOT)/home/picazo/usr/lib/$(TARGET0)"
	-$(SYMLINK) "$(TARGET)" "$(INSTALL_ROOT)/home/picazo/usr/lib/$(TARGET1)"
	-$(SYMLINK) "$(TARGET)" "$(INSTALL_ROOT)/home/picazo/usr/lib/$(TARGET2)"

uninstall_target:  FORCE
	-$(DEL_FILE) "$(INSTALL_ROOT)/home/picazo/usr/lib/$(TARGET)" 
	 -$(DEL_FILE) "$(INSTALL_ROOT)/home/picazo/usr/lib/$(TARGET0)" 
	 -$(DEL_FILE) "$(INSTALL_ROOT)/home/picazo/usr/lib/$(TARGET1)" 
	 -$(DEL_FILE) "$(INSTALL_ROOT)/home/picazo/usr/lib/$(TARGET2)"
	-$(DEL_DIR) $(INSTALL_ROOT)/home/picazo/usr/lib/ 


install:  install_target  FORCE

uninstall: uninstall_target   FORCE


debug/moc_tsqltablenavigator.o: debug/moc_tsqltablenavigator.cpp debug/componentes.gch/c++
	$(CXX) -c -include debug/componentes $(CXXFLAGS) $(INCPATH) -o debug/moc_tsqltablenavigator.o debug/moc_tsqltablenavigator.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/home/bruno/usr/lib || mkdir -p $(INSTALL_ROOT)/home/bruno/usr/lib
	$(QINSTALL_PROGRAM) lib/$(TARGET) $(INSTALL_ROOT)/home/bruno/usr/lib/$(TARGET)
	-$(SYMLINK) $(TARGET) $(INSTALL_ROOT)/home/bruno/usr/lib/$(TARGET0)
	-$(SYMLINK) $(TARGET) $(INSTALL_ROOT)/home/bruno/usr/lib/$(TARGET1)
	-$(SYMLINK) $(TARGET) $(INSTALL_ROOT)/home/bruno/usr/lib/$(TARGET2)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/home/bruno/usr/lib/$(TARGET) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/home/bruno/usr/lib/$(TARGET0) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/home/bruno/usr/lib/$(TARGET1) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/home/bruno/usr/lib/$(TARGET2)
	-$(DEL_DIR) $(INSTALL_ROOT)/home/bruno/usr/lib/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

.SUFFIXES:


QMAKE_TARGET  = componentes
DESTDIR       = lib/
TARGET        = libcomponentes.so.1.0.0
TARGETA       = lib/libcomponentes.a
TARGET0       = libcomponentes.so
TARGETD       = libcomponentes.so.1.0.0
TARGET1       = libcomponentes.so.1
TARGET2       = libcomponentes.so.1.0


first: all
####### Build rules

lib/libcomponentes.so.1.0.0: ui_include/ui_tsqlbuttonbox.h ui_include/ui_tsqltablenavigator.h $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@test -d lib/ || mkdir -p lib/
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) lib/$(TARGET)
	-$(MOVE) $(TARGET) lib/$(TARGET)
	-$(DEL_FILE) lib/$(TARGET0)
	-$(DEL_FILE) lib/$(TARGET1)
	-$(DEL_FILE) lib/$(TARGET2)
	-$(MOVE) $(TARGET0) lib/$(TARGET0)
	-$(MOVE) $(TARGET1) lib/$(TARGET1)
	-$(MOVE) $(TARGET2) lib/$(TARGET2)



staticlib: lib/libcomponentes.a

lib/libcomponentes.a: ui_include/ui_tsqlbuttonbox.h ui_include/ui_tsqltablenavigator.h $(OBJECTS) $(OBJCOMP) 
	-$(DEL_FILE) $(TARGETA) 
	$(AR) $(TARGETA) $(OBJECTS)

qmake: FORCE
	@$(QMAKE) -o Makefile.Debug componentes.pro -spec linux-g++ CONFIG+=release

qmake_all: FORCE


all: Makefile.Debug lib/libcomponentes.so.1.0.0

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib64/qt6/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents base/magnitude.h base/unit.h base/dimension.h base/unitsystem.h base/unitcollection.h data/seqtablemodel.h data/combodatamodel.h data/fkmodel.h data/foreignkey.h data/baseforeignkey.h data/rowcontrol.h data/rowcontrolchild.h data/rowcontrolchildcolumnproxy.h data/relone2one.h data/relone2oneproxy.h widgets/datadialog.h widgets/tcombobox.h widgets/dimensionedit.h widgets/fkitemdelegate.h widgets/ttabwidget.h widgets/tsqlbuttonbox.h widgets/ttableview.h widgets/tsqltablenavigator.h $(DISTDIR)/
	$(COPY_FILE) --parents base/magnitude.cpp base/unit.cpp base/dimension.cpp base/unitsystem.cpp base/unitcollection.cpp data/seqtablemodel.cpp data/combodatamodel.cpp data/fkmodel.cpp data/baseforeignkey.cpp data/foreignkey.cpp data/rowcontrol.cpp data/rowcontrolchild.cpp data/rowcontrolchildcolumnproxy.cpp data/relone2one.cpp data/relone2oneproxy.cpp widgets/datadialog.cpp widgets/tcombobox.cpp widgets/dimensionedit.cpp widgets/fkitemdelegate.cpp widgets/ttabwidget.cpp widgets/tsqlbuttonbox.cpp widgets/ttableview.cpp widgets/tsqltablenavigator.cpp $(DISTDIR)/
	$(COPY_FILE) --parents widgets/tsqlbuttonbox.ui widgets/tsqltablenavigator.ui $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) debug/componentes.gch/c debug/componentes.gch/c++
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) lib/$(TARGET) 
	-$(DEL_FILE) lib/$(TARGET0) lib/$(TARGET1) lib/$(TARGET2) $(TARGETA)
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile.Debug


####### Sub-libraries

###### Precompiled headers
debug/componentes.gch/c: include/static.h 
	@test -d debug/componentes.gch/ || mkdir -p debug/componentes.gch/
	$(CC) $(CFLAGS) $(INCPATH) -x c-header -c include/static.h -o debug/componentes.gch/c

debug/componentes.gch/c++: include/static.h 
	@test -d debug/componentes.gch/ || mkdir -p debug/componentes.gch/
	$(CXX) $(CXXFLAGS) $(INCPATH) -x c++-header -c include/static.h -o debug/componentes.gch/c++

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_no_pch_compiler_make_all:
compiler_no_pch_compiler_clean:
compiler_rcc_make_all:
compiler_rcc_clean:
compiler_moc_predefs_make_all: debug/moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) debug/moc_predefs.h
debug/moc_predefs.h: /usr/lib64/qt6/mkspecs/features/data/dummy.cpp \
		debug/componentes.gch/c++
	g++ -pipe -g -std=gnu++1z -Wall -Wextra -dM -E -o debug/moc_predefs.h /usr/lib64/qt6/mkspecs/features/data/dummy.cpp

